PORT=4000

# MongoDB Atlas connection string
# Get this from: Atlas Dashboard → Your Cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/interview_bot?retryWrites=true&w=majority

GEMINI_API_KEY=your_gemini_api_key_here
RESUME_PARSER_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
